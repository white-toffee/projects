{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true
  },
  "include": [
    ".cache/app.js",
    "desktop/**/*.mjs",
    "scripts/**/*.mjs",
    "tests/**/*.js",
    "types/**/*.d.ts"
  ]
}
